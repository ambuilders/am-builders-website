# Vercel Blob read/write token, used by app/api/floor-plan-lead/route.ts to
# store the generated concept floor plan PDF, once that tool is re-enabled
# (it currently ships as a disabled stub — see the comment at the top of
# that file). When this project is deployed on Vercel with Blob storage
# enabled, Vercel injects this automatically — you shouldn't need to set it
# manually there. For local development, run `vercel env pull .env.local`
# after enabling Blob storage on the project, or copy the token from
# Vercel's dashboard under Storage → your Blob store → .env.local tab.
BLOB_READ_WRITE_TOKEN=

# Anthropic API key used by lib/floor-plan/extract-layout.ts to analyze an
# uploaded floor plan photo/scan/PDF (via app/api/floor-plan-lead/route.ts)
# and ground the generated concepts in the lead's real basement shape. Also
# used by app/api/generate-review/route.ts to draft review text on the
# password-protected /review page. Get a key at
# https://console.anthropic.com/settings/keys. This is called server-side
# only — never expose this key to client code. Until this is set, uploads
# are skipped gracefully and generation falls back to the sqft-based logic;
# nothing breaks, it just runs without the upload.
ANTHROPIC_API_KEY=

# Password gate for the /review page (a link you send to past customers so
# they can draft and post a Google review) — checked in
# app/api/review-login/route.ts. Anyone with this password gets in; it's a
# shared password, not a per-person login. Until this is set, nobody can log
# in (see middleware.ts).
REVIEW_PAGE_PASSWORD=

# Opaque random string stored in the visitor's login cookie after they enter
# REVIEW_PAGE_PASSWORD correctly (see app/api/review-login/route.ts and
# middleware.ts) — this is NOT the password itself, so a leaked cookie
# doesn't hand over the login password. Generate one with:
#   openssl rand -hex 32
REVIEW_SESSION_SECRET=

# Odoo CRM connection used by app/api/lead/route.ts (via lib/odoo.ts) to
# create a crm.lead record for every contact-form submission, over Odoo's
# JSON-RPC external API. All four are required — until they're set, the
# contact form returns a friendly error to the visitor instead of silently
# dropping the lead.
#
# ODOO_URL   — the instance base URL, e.g. https://am-builders.odoo.com
# ODOO_DB    — the database name (often the subdomain, but confirm in Odoo
#              under Settings > General Settings, or ask Odoo support)
# ODOO_LOGIN — the email/username of the Odoo user the API key belongs to
# ODOO_API_KEY — generate one as that user: click the profile avatar (top
#              right) > My Profile > Account Security tab > New API Key.
#              That user needs CRM lead-creation permission.
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
ODOO_API_KEY=

# Google Places API (New), used by lib/google-reviews.ts to show real Google
# reviews on the homepage (components/GoogleReviewsSection.tsx). Create a key
# in Google Cloud Console with "Places API (New)" enabled and billing
# attached, then restrict the key to that API only (server-side only calls —
# no HTTP referrer restriction needed). Until this is set, the reviews
# section falls back to a "check back soon" message instead of breaking the
# build. Cached/revalidated once a day, so this costs ~1 request/day.
GOOGLE_PLACES_API_KEY=

# Optional: once the confirmed Place ID for the AM Builders listing is known
# (starts with "ChIJ..."), set this to skip the searchText lookup and go
# straight to Place Details. Safe to leave unset — lib/google-reviews.ts
# finds the listing by business name/address/phone match instead.
GOOGLE_PLACE_ID=

# --- Client portal (app/client-portal/**) ---------------------------------
# None of this is used by the marketing site; the portal is the only consumer.

# Neon Postgres connection string, from Vercel > Storage > your Neon database
# (Marketplace). Use the pooled connection string. Holds portal accounts,
# projects, milestones, photo/document metadata, warranty records and
# messages. Quotes and invoices are NOT stored here — they are read live from
# Odoo so the portal can never show stale financials.
DATABASE_URL=

# Auth.js session and token signing secret. Generate one with:
#   openssl rand -base64 32
# Must be identical across every environment sharing a database.
AUTH_SECRET=

# Canonical URL Auth.js builds magic links against. Vercel sets this
# automatically in production; set it to http://localhost:3000 locally.
AUTH_URL=

# SMTP for portal sign-in links. Deliberately NOT Odoo — that account is
# capped at 5 emails per day, and login links must never queue behind it.
# Hostinger mailbox credentials, or another transactional provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

